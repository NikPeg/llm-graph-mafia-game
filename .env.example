# OpenRouter API settings
OPENROUTER_API_KEY=local_test_key

# Port-based model configuration
# Large model (32B) runs on port 8000, small model (8B) on port 8001
LARGE_MODEL_PORT=8000
SMALL_MODEL_PORT=8001

# Model names for Firebase logging and dashboard display
LARGE_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
SMALL_MODEL_NAME=deepseek/deepseek-llm-7b-chat

# Experiment mode: set to 'role_specific' to use different models per role, 'single' for same model
EXPERIMENT_MODE=role_specific

# Role-specific port configuration
# Smart Mafia (32B) vs Simple Villagers (8B) experiment:
MAFIA_MODEL_PORT=8000
VILLAGER_MODEL_PORT=8001
DOCTOR_MODEL_PORT=8001

# Alternative experiment configurations:
#
# Smart Villagers vs Simple Mafia:
# MAFIA_MODEL_PORT=8001
# VILLAGER_MODEL_PORT=8000
# DOCTOR_MODEL_PORT=8000
#
# All use large model:
# MAFIA_MODEL_PORT=8000
# VILLAGER_MODEL_PORT=8000
# DOCTOR_MODEL_PORT=8000
#
# All use small model:
# MAFIA_MODEL_PORT=8001
# VILLAGER_MODEL_PORT=8001
# DOCTOR_MODEL_PORT=8001

# Legacy model configuration (for backward compatibility)
MODEL_NAME=gryphe/mythomax-l2-13b
MAFIA_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
VILLAGER_MODEL=deepseek/deepseek-llm-7b-chat
DOCTOR_MODEL=deepseek/deepseek-llm-7b-chat

# Game configuration
NUM_GAMES=3
PARALLEL=false
MAX_WORKERS=4
PLAYERS_PER_GAME=8
MAFIA_COUNT=2
DOCTOR_COUNT=1
MAX_ROUNDS=20

# SSH settings (if using remote deployment)
SSH_USER=your_ssh_username_here
SSH_HOST=your_ssh_host_here
COMPOSE_DIR=your_compose_directory_here
PEM_KEY_PATH=your_pem_key_path_here

# RAG (Retrieval-Augmented Generation) settings
RAG_ENABLED=true
RAG_TYPE=DG
RAG_TARGET=all

# RAG_TYPE options:
# DG - Discussion Graph (discussion_graph)
# HG - History Graph (history_graph)
# CRG - Current Round Graph (current_round_graph)
# CG - Communication Graph (communication_graph)
# AS - Auto Summaries (auto_summaries)
# AH - Analytical Hints (analytical_hints)

# RAG_TARGET options:
# all - Enable RAG for all players
# mafia - Enable RAG only for Mafia players
# villagers - Enable RAG only for Villager and Doctor players

# Available models (for reference):
# gryphe/mythomax-l2-13b
# mistralai/mistral-small-24b-instruct-2501
# deepseek/deepseek-llm-7b-chat
# deepseek/deepseek-r1-distill-llama-70b
# nousresearch/hermes-3-llama-3.1-70b
# deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
